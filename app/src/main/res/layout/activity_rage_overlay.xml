<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rage_background"
    tools:context=".ui.RageOverlayActivity">

    <!-- Blast text layer - behind main UI -->
    <FrameLayout
        android:id="@+id/blastContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main content container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- App name -->
        <TextView
            android:id="@+id/tvBlockedAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:textColor="@color/rage_text"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="INSTAGRAM" />

        <!-- Usage time -->
        <TextView
            android:id="@+id/tvUsageTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:gravity="center"
            android:textColor="@color/rage_text"
            android:textSize="18sp"
            tools:text="32m wasted today" />

        <!-- Rage message container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvRageMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/rage_text"
                android:textSize="42sp"
                android:textStyle="bold"
                tools:text="YOU USED THIS FOR 4 HOURS." />

        </FrameLayout>

        <!-- Done button -->
        <Button
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/rage_text"
            android:text="@string/done"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Vibration indicator -->
    <View
        android:id="@+id/vibrationIndicator"
        android:layout_width="4dp"
        android:layout_height="64dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="8dp"
        android:background="@color/rage_text"
        android:visibility="gone" />

</FrameLayout>
